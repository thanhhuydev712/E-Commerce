# SecureString payload; URL-encode credentials, use the SELECT-only preview role.
DATABASE_URL=postgresql://rigforce_app:URL_ENCODED_PASSWORD@DB_HOST:5432/rigforce?sslmode=verify-full&sslrootcert=/run/certs/rds-global-bundle.pem
DATABASE_SCHEMA=public
# Optional controlled-account demo; defaults to false. Orders/payments remain blocked.
INTERACTIVE_DEMO=false
# Optional controlled-account reset. Requires INTERACTIVE_DEMO=true and SES SMTP config below.
PASSWORD_RECOVERY_ENABLED=false
# When enabled, add these exact keys to the encrypted runtime SecureString:
# PASSWORD_RECOVERY_ALLOWED_EMAILS=demo@example.com
# CHALLENGE_DELIVERY=smtp
# SMTP_HOST=email-smtp.ap-southeast-2.amazonaws.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=REPLACE_WITH_SCOPED_SMTP_USER
# SMTP_PASSWORD=REPLACE_WITH_SCOPED_SMTP_PASSWORD
# SMTP_FROM=demo@example.com
JWT_SECRET=REPLACE_WITH_RANDOM_64_HEX_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_RANDOM_64_HEX_SECRET
ALLOWED_ORIGINS=https://demo.example.com
STOREFRONT_URL=https://demo.example.com
