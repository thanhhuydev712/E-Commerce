# Separate SecureString payload; migration role only, not mounted into the API service.
DATABASE_URL=postgresql://rigforce_migrate:URL_ENCODED_PASSWORD@DB_HOST:5432/rigforce?sslmode=verify-full&sslrootcert=/run/certs/rds-global-bundle.pem
PRISMA_MIGRATION_DATABASE_URL=postgresql://rigforce_migrate:URL_ENCODED_PASSWORD@DB_HOST:5432/rigforce?sslmode=require&sslaccept=strict&sslcert=/run/certs/rds-global-bundle.pem
DATABASE_SCHEMA=public
