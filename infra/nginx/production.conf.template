log_format rigforce '$remote_addr [$time_local] "$request_method $uri $server_protocol" '
                    '$status $body_bytes_sent request_id=$upstream_http_x_request_id';
server {
    listen 80;
    server_name ${DOMAIN_NAME};
    location ^~ /.well-known/acme-challenge/ { root /var/www/acme; }
    location / { return 308 https://${DOMAIN_NAME}$request_uri; }
}
server {
    listen 443 ssl;
    server_name ${DOMAIN_NAME};
    ssl_certificate /etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_NAME}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    access_log /var/log/nginx/access.log rigforce;
    client_max_body_size 6m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $api http://api:3001;
    set $front http://front:3000;
    proxy_http_version 1.1;
    proxy_set_header Host $http_host;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Connection "";
    proxy_connect_timeout 5s;
    proxy_read_timeout 60s;
    location ^~ /api/docs { return 404; }
    location = /api/v1/health/ready { return 404; }
    location /api/ { proxy_pass $api$request_uri; }
    location / { proxy_pass $front$request_uri; proxy_buffering off; }
}
