# Fill real values locally. Never commit .env or copy secrets into documentation.
NODE_ENV=development
PORT=3001
# 0 khi chạy trực tiếp; chỉ đặt 1 sau reverse proxy đã biết và ghi đè forwarded headers.
TRUST_PROXY_HOPS=0
# Public showcase uses true; local development keeps the existing account/cart flow.
PREVIEW_READ_ONLY=false
# Production deployment requires verified PostgreSQL TLS and a mounted root CA.
DATABASE_TLS_REQUIRED=false
DATABASE_URL=
DATABASE_SCHEMA=public
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=900
REFRESH_TTL_SECONDS=604800
# Include the API origin to allow login from its local Swagger UI.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Optional separate development/test connection; E2E always creates its own schema.
TEST_DATABASE_URL=
# Local upload directory, relative to the api working directory or absolute.
# Deployment needs persistent storage and backup; never commit uploaded files.
MEDIA_ROOT=.local-media
# Optional Stripe sandbox. Both secrets are needed to offer online payment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Exact frontend origin, also present in ALLOWED_ORIGINS; defaults to first allowed origin.
STOREFRONT_URL=http://localhost:3000
# Email challenge transport: memory (local/test only), smtp, or disabled.
# Production defaults to disabled. Public PREVIEW_READ_ONLY must keep disabled.
CHALLENGE_DELIVERY=memory
# Controlled demo recovery is opt-in; requires PREVIEW_READ_ONLY=true,
# INTERACTIVE_DEMO=true, SMTP and an exact 1..5 email allowlist.
# Production SMTP is refused until this explicit recovery configuration is set.
PASSWORD_RECOVERY_ENABLED=false
# PASSWORD_RECOVERY_ALLOWED_EMAILS=trial@example.com
# SMTP_FROM must be in that list; signup and email verification stay closed.
# Controlled login/cart/saved-PC only; requires PREVIEW_READ_ONLY=true. No signup/orders.
INTERACTIVE_DEMO=false
# SMTP requires implicit TLS (465) or STARTTLS (587); certificates are verified.
# SMTP_FROM is one bare email address. Store credentials only in local/runtime secrets.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
