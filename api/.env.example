# Fill real values locally. Never commit .env or copy secrets into documentation.
NODE_ENV=development
PORT=3001
DATABASE_URL=
DATABASE_SCHEMA=public
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=900
REFRESH_TTL_SECONDS=604800
# Include the API origin to allow login from its local Swagger UI.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Optional separate development/test connection; E2E always creates its own schema.
TEST_DATABASE_URL=
# Local upload directory, relative to the api working directory or absolute.
# Deployment needs persistent storage and backup; never commit uploaded files.
MEDIA_ROOT=.local-media
