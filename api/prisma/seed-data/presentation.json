  "informationPages": {
    "installments": {
      "title": "Thông tin trả góp",
      "paragraphs": [
        "Đây là trang thông tin minh họa trong dự án Rigforge. Chưa có đối tác tài chính, đăng ký trả góp hoặc dịch vụ tín dụng được tích hợp.",
        "Khi có dịch vụ thực tế, trang cần công khai điều kiện áp dụng, kỳ hạn, tổng chi phí, hồ sơ và liên kết tới nhà cung cấp đã được xác minh. Bản trải nghiệm hiện chỉ hỗ trợ đặt hàng mô phỏng."
      ]
    },
    "about": {
      "title": "Rigforge — Tạo chất riêng từ từng linh kiện",
      "paragraphs": [
        "Rigforge là giao diện cửa hàng công nghệ trong dự án học tập fullstack. Chúng mình xây dựng trải nghiệm giúp bạn khám phá sản phẩm, hiểu cấu hình và hình dung chiếc PC của riêng mình.",
        "Website hiện sử dụng dữ liệu mẫu. Giá, tồn, ưu đãi, bảo hành và giao hàng mang tính minh họa; không có giao dịch hoặc cam kết dịch vụ thật."
      ]
    },
    "shipping": {
      "title": "Giao hàng & thanh toán",
      "paragraphs": [
        "Quy tắc demo: giao tiêu chuẩn 30.000₫, miễn phí với tạm tính từ 5.000.000₫. Giao nhanh cộng thêm 20.000₫. Thời gian giao trên checkout chỉ là minh họa.",
        "Thanh toán có ba kịch bản: thành công, đang xử lý và thất bại. Không nhập thông tin thẻ thật. Không có request tới Stripe hoặc đơn vị vận chuyển."
      ]
    },
    "returns": {
      "title": "Đổi trả & hoàn tiền",
      "paragraphs": [
        "Bản trải nghiệm cho phép lưu yêu cầu mẫu trong tài khoản. Điều kiện đổi trả, kiểm tra hàng, phân bổ tiền hoàn và thời hạn xử lý cần được chốt khi triển khai nghiệp vụ thật.",
        "Hủy đơn và hoàn tiền là hai trạng thái riêng. Một đơn đã hủy không tự động trở thành đã hoàn tiền."
      ]
    },
    "warranty": {
      "title": "Thông tin bảo hành",
      "paragraphs": [
        "Thời hạn ở mỗi sản phẩm là dữ liệu minh họa. Chính sách thực tế phải theo sản phẩm, nhà cung cấp và chứng từ hợp lệ.",
        "Tại đây bạn có thể thử tạo yêu cầu bảo hành mẫu. Kiểm tra serial, điều kiện áp dụng và quy trình bàn giao thực tế chưa được tích hợp."
      ]
    },
    "privacy": {
      "title": "Quyền riêng tư trong bản demo",
      "paragraphs": [
        "Trạng thái giỏ, tài khoản mẫu, yêu thích, cấu hình và các yêu cầu được lưu trên trình duyệt. Không có API nghiệp vụ nhận dữ liệu từ bản demo.",
        "Chỉ nhập tên, email, số điện thoại và địa chỉ giả. Không nhập mật khẩu hay thông tin thanh toán thật. Xóa dữ liệu trang trong trình duyệt sẽ xóa các bản lưu local."
      ]
    }
  },
