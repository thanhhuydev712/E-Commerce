// E-Commerce v2 target schema (102 models). Not yet migrated or compatible with v1 services.
// See docs/database/PRISMA_V2.md and prisma/v2/constraints.sql before any DB change.
// State fields intentionally use varchar + SQL CHECK, as specified in the design.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-v2"
}

datasource db {
  provider = "postgresql"
}

/// users: see docs/database/DATA_DICTIONARY.md.
model User {
  id                String    @id @default(uuid()) @db.Uuid
  email             String    @unique @db.VarChar(254)
  passwordHash      String    @map("password_hash") @db.Text
  firstName         String?   @map("first_name") @db.VarChar(100)
  lastName          String?   @map("last_name") @db.VarChar(100)
  phone             String?   @db.VarChar(32)
  status            String    @db.VarChar(32)
  emailVerifiedAt   DateTime? @map("email_verified_at") @db.Timestamptz(6)
  passwordChangedAt DateTime? @map("password_changed_at") @db.Timestamptz(6)
  archivedAt        DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  userRolesByUser             UserRole[]               @relation("UserRole_userId")
  userRolesByAssignedBy       UserRole[]               @relation("UserRole_assignedBy")
  authSessions                AuthSession[]            @relation("AuthSession_userId")
  authChallenges              AuthChallenge[]          @relation("AuthChallenge_userId")
  addresses                   Address[]                @relation("Address_userId")
  mediaAssets                 MediaAsset[]             @relation("MediaAsset_uploadedBy")
  inventoryMovements          InventoryMovement[]      @relation("InventoryMovement_actorId")
  purchaseOrders              PurchaseOrder[]          @relation("PurchaseOrder_approvedBy")
  goodsReceipts               GoodsReceipt[]           @relation("GoodsReceipt_postedBy")
  stockTransfers              StockTransfer[]          @relation("StockTransfer_createdBy")
  stockCounts                 StockCount[]             @relation("StockCount_approvedBy")
  carts                       Cart[]                   @relation("Cart_userId")
  checkoutSessions            CheckoutSession[]        @relation("CheckoutSession_userId")
  orders                      Order[]                  @relation("Order_userId")
  orderStatusHistory          OrderStatusHistory[]     @relation("OrderStatusHistory_actorId")
  orderNotes                  OrderNote[]              @relation("OrderNote_authorId")
  promotionRedemptions        PromotionRedemption[]    @relation("PromotionRedemption_userId")
  refundsByRequestedBy        Refund[]                 @relation("Refund_requestedBy")
  refundsByApprovedBy         Refund[]                 @relation("Refund_approvedBy")
  reconciliationIssues        ReconciliationIssue[]    @relation("ReconciliationIssue_resolvedBy")
  returnRequestsByRequestedBy ReturnRequest[]          @relation("ReturnRequest_requestedBy")
  returnRequestsByApprovedBy  ReturnRequest[]          @relation("ReturnRequest_approvedBy")
  returnInspections           ReturnInspection[]       @relation("ReturnInspection_inspectorId")
  returnReceipts              ReturnReceipt[]          @relation("ReturnReceipt_receivedBy")
  serialUnitEvents            SerialUnitEvent[]        @relation("SerialUnitEvent_actorId")
  warrantyClaims              WarrantyClaim[]          @relation("WarrantyClaim_userId")
  warrantyEvents              WarrantyEvent[]          @relation("WarrantyEvent_actorId")
  wishlists                   Wishlist[]               @relation("Wishlist_userId")
  reviewsByUser               Review[]                 @relation("Review_userId")
  reviewsByModeratedBy        Review[]                 @relation("Review_moderatedBy")
  reviewVotes                 ReviewVote[]             @relation("ReviewVote_userId")
  contentPages                ContentPage[]            @relation("ContentPage_authorId")
  articles                    Article[]                @relation("Article_authorId")
  supportTicketsByUser        SupportTicket[]          @relation("SupportTicket_userId")
  supportTicketsByAssignedTo  SupportTicket[]          @relation("SupportTicket_assignedTo")
  supportMessages             SupportMessage[]         @relation("SupportMessage_authorId")
  notifications               Notification[]           @relation("Notification_userId")
  notificationPreferences     NotificationPreference[] @relation("NotificationPreference_userId")
  auditLogs                   AuditLog[]               @relation("AuditLog_actorId")
  storeSettings               StoreSetting[]           @relation("StoreSetting_changedBy")
  savedPcBuilds               SavedPcBuild[]

  @@map("users")
}

/// roles: see docs/database/DATA_DICTIONARY.md.
model Role {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(64)
  name        String   @db.VarChar(100)
  description String?  @db.Text
  isSystem    Boolean  @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  userRoles       UserRole[]       @relation("UserRole_roleId")
  rolePermissions RolePermission[] @relation("RolePermission_roleId")

  @@map("roles")
}

/// permissions: see docs/database/DATA_DICTIONARY.md.
model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(100)
  description String   @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  rolePermissions RolePermission[] @relation("RolePermission_permissionId")

  @@map("permissions")
}

/// user_roles: see docs/database/DATA_DICTIONARY.md.
model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedBy String?  @map("assigned_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user           User  @relation("UserRole_userId", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role           Role  @relation("UserRole_roleId", fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignedByUser User? @relation("UserRole_assignedBy", fields: [assignedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@index([assignedBy])
  @@map("user_roles")
}

/// role_permissions: see docs/database/DATA_DICTIONARY.md.
model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  role       Role       @relation("RolePermission_roleId", fields: [roleId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  permission Permission @relation("RolePermission_permissionId", fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// auth_sessions: see docs/database/DATA_DICTIONARY.md.
model AuthSession {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  familyId          String    @map("family_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.Text
  previousTokenHash String?   @map("previous_token_hash") @db.Text
  deviceLabel       String?   @map("device_label") @db.VarChar(200)
  userAgent         String?   @map("user_agent") @db.VarChar(512)
  ipHash            String?   @map("ip_hash") @db.VarChar(128)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  rotatedAt         DateTime? @map("rotated_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokeReason      String?   @map("revoke_reason") @db.VarChar(64)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation("AuthSession_userId", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([familyId], map: "auth_sessions_family_idx")
  @@map("auth_sessions")
}

/// auth_challenges: see docs/database/DATA_DICTIONARY.md.
model AuthChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  purpose    String    @db.VarChar(32)
  tokenHash  String    @unique @map("token_hash") @db.Text
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(6)
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation("AuthChallenge_userId", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId])
  @@map("auth_challenges")
}

/// addresses: see docs/database/DATA_DICTIONARY.md.
model Address {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  label             String?   @db.VarChar(100)
  recipientName     String    @map("recipient_name") @db.VarChar(200)
  phone             String    @db.VarChar(32)
  countryCode       String    @map("country_code") @db.VarChar(2)
  regionCode        String?   @map("region_code") @db.VarChar(32)
  regionName        String?   @map("region_name") @db.VarChar(150)
  locality          String?   @db.VarChar(150)
  postalCode        String?   @map("postal_code") @db.VarChar(32)
  line1             String    @db.VarChar(300)
  line2             String?   @db.VarChar(300)
  isDefaultShipping Boolean   @map("is_default_shipping")
  isDefaultBilling  Boolean   @map("is_default_billing")
  archivedAt        DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation("Address_userId", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([userId])
  @@map("addresses")
}

/// currencies: see docs/database/DATA_DICTIONARY.md.
model Currency {
  code      String   @id @db.VarChar(3)
  name      String   @db.VarChar(100)
  minorUnit Int      @map("minor_unit")
  isActive  Boolean  @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  variantPrices       VariantPrice[]       @relation("VariantPrice_currencyCode")
  supplierVariants    SupplierVariant[]    @relation("SupplierVariant_currencyCode")
  purchaseOrders      PurchaseOrder[]      @relation("PurchaseOrder_currencyCode")
  goodsReceiptItems   GoodsReceiptItem[]   @relation("GoodsReceiptItem_currencyCode")
  carts               Cart[]               @relation("Cart_currencyCode")
  checkoutSessions    CheckoutSession[]    @relation("CheckoutSession_currencyCode")
  orders              Order[]              @relation("Order_currencyCode")
  promotions          Promotion[]          @relation("Promotion_currencyCode")
  payments            Payment[]            @relation("Payment_currencyCode")
  paymentTransactions PaymentTransaction[] @relation("PaymentTransaction_currencyCode")
  refunds             Refund[]             @relation("Refund_currencyCode")
  shippingRates       ShippingRate[]       @relation("ShippingRate_currencyCode")
  invoices            Invoice[]            @relation("Invoice_currencyCode")
  creditNotes         CreditNote[]         @relation("CreditNote_currencyCode")

  @@map("currencies")
}

/// brands: see docs/database/DATA_DICTIONARY.md.
model Brand {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(150)
  slug        String   @unique @db.VarChar(180)
  description String?  @db.Text
  logoAssetId String?  @map("logo_asset_id") @db.Uuid
  status      String   @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  logoAsset MediaAsset? @relation("Brand_logoAssetId", fields: [logoAssetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  products  Product[]   @relation("Product_brandId")

  @@index([logoAssetId])
  @@map("brands")
}

/// categories: see docs/database/DATA_DICTIONARY.md.
model Category {
  id           String   @id @default(uuid()) @db.Uuid
  parentId     String?  @map("parent_id") @db.Uuid
  name         String   @db.VarChar(150)
  slug         String   @unique @db.VarChar(180)
  description  String?  @db.Text
  sortOrder    Int      @map("sort_order")
  status       String   @db.VarChar(32)
  imageAssetId String?  @map("image_asset_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent              Category?           @relation("Category_parentId", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  imageAsset          MediaAsset?         @relation("Category_imageAssetId", fields: [imageAssetId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  categories          Category[]          @relation("Category_parentId")
  productCategories   ProductCategory[]   @relation("ProductCategory_categoryId")
  categoryAttributes  CategoryAttribute[] @relation("CategoryAttribute_categoryId")
  promotionCategories PromotionCategory[] @relation("PromotionCategory_categoryId")

  @@index([parentId])
  @@index([imageAssetId])
  @@map("categories")
}

/// products: see docs/database/DATA_DICTIONARY.md.
model Product {
  id               String    @id @default(uuid()) @db.Uuid
  brandId          String?   @map("brand_id") @db.Uuid
  name             String    @db.VarChar(250)
  slug             String    @unique @db.VarChar(280)
  summary          String?   @db.Text
  description      String?   @db.Text
  status           String    @db.VarChar(32)
  taxClassId       String?   @map("tax_class_id") @db.Uuid
  warrantyPolicyId String?   @map("warranty_policy_id") @db.Uuid
  publishedAt      DateTime? @map("published_at") @db.Timestamptz(6)
  archivedAt       DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  brand                  Brand?                  @relation("Product_brandId", fields: [brandId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  taxClass               TaxClass?               @relation("Product_taxClassId", fields: [taxClassId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  warrantyPolicy         WarrantyPolicy?         @relation("Product_warrantyPolicyId", fields: [warrantyPolicyId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  productCategories      ProductCategory[]       @relation("ProductCategory_productId")
  productMedia           ProductMedia[]          @relation("ProductMedia_productId")
  productVariants        ProductVariant[]        @relation("ProductVariant_productId")
  productOptions         ProductOption[]         @relation("ProductOption_productId")
  productAttributeValues ProductAttributeValue[] @relation("ProductAttributeValue_productId")
  promotionProducts      PromotionProduct[]      @relation("PromotionProduct_productId")
  reviews                Review[]                @relation("Review_productId")
  collectionProducts     CollectionProduct[]     @relation("CollectionProduct_productId")
  savedPcBuildComponents SavedPcBuildComponent[]

  @@index([status, publishedAt, id])
  @@index([brandId])
  @@index([taxClassId])
  @@index([warrantyPolicyId])
  @@map("products")
}

/// product_categories: see docs/database/DATA_DICTIONARY.md.
model ProductCategory {
  productId  String   @map("product_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  isPrimary  Boolean  @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  product  Product  @relation("ProductCategory_productId", fields: [productId], references: [id], onDelete: Cascade, onUpdate: Restrict)
  category Category @relation("ProductCategory_categoryId", fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([productId, categoryId])
  @@index([categoryId])
  @@map("product_categories")
}

/// media_assets: see docs/database/DATA_DICTIONARY.md.
model MediaAsset {
  id           String   @id @default(uuid()) @db.Uuid
  storageKey   String   @unique @map("storage_key") @db.VarChar(512)
  originalName String   @map("original_name") @db.VarChar(255)
  mimeType     String   @map("mime_type") @db.VarChar(100)
  sizeBytes    BigInt   @map("size_bytes")
  width        Int?
  height       Int?
  checksum     String?  @db.VarChar(128)
  status       String   @db.VarChar(32)
  uploadedBy   String?  @map("uploaded_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  uploadedByUser     User?               @relation("MediaAsset_uploadedBy", fields: [uploadedBy], references: [id], onDelete: Restrict, onUpdate: Restrict)
  brands             Brand[]             @relation("Brand_logoAssetId")
  categories         Category[]          @relation("Category_imageAssetId")
  productMedia       ProductMedia[]      @relation("ProductMedia_assetId")
  warrantyEvents     WarrantyEvent[]     @relation("WarrantyEvent_assetId")
  reviewMedia        ReviewMedia[]       @relation("ReviewMedia_assetId")
  articles           Article[]           @relation("Article_coverAssetId")
  banners            Banner[]            @relation("Banner_assetId")
  supportAttachments SupportAttachment[] @relation("SupportAttachment_assetId")

  @@index([uploadedBy])
  @@map("media_assets")
}

/// product_media: see docs/database/DATA_DICTIONARY.md.
model ProductMedia {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  variantId String?  @map("variant_id") @db.Uuid
  assetId   String   @map("asset_id") @db.Uuid
  altText   String?  @map("alt_text") @db.VarChar(300)
  sortOrder Int      @map("sort_order")
  isPrimary Boolean  @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product Product         @relation("ProductMedia_productId", fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  variant ProductVariant? @relation("ProductMedia_variantId", fields: [variantId, productId], references: [id, productId], onDelete: Restrict, onUpdate: Restrict)
  asset   MediaAsset      @relation("ProductMedia_assetId", fields: [assetId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([productId, assetId])
  @@index([variantId])
  @@index([assetId])
  @@map("product_media")
}

/// product_variants: see docs/database/DATA_DICTIONARY.md.
model ProductVariant {
  id              String    @id @default(uuid()) @db.Uuid
  productId       String    @map("product_id") @db.Uuid
  sku             String    @unique @db.VarChar(100)
  barcode         String?   @unique @db.VarChar(100)
  name            String?   @db.VarChar(200)
  optionSignature String    @map("option_signature") @db.VarChar(512)
  status          String    @db.VarChar(32)
  weightGrams     Int?      @map("weight_grams")
  lengthMm        Int?      @map("length_mm")
  widthMm         Int?      @map("width_mm")
  heightMm        Int?      @map("height_mm")
  trackSerial     Boolean   @default(false) @map("track_serial")
  archivedAt      DateTime? @map("archived_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  product                Product                 @relation("ProductVariant_productId", fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  productMedia           ProductMedia[]          @relation("ProductMedia_variantId")
  variantOptionValues    VariantOptionValue[]    @relation("VariantOptionValue_variantId")
  variantAttributeValues VariantAttributeValue[] @relation("VariantAttributeValue_variantId")
  variantPrices          VariantPrice[]          @relation("VariantPrice_variantId")
  inventoryBalances      InventoryBalance[]      @relation("InventoryBalance_variantId")
  supplierVariants       SupplierVariant[]       @relation("SupplierVariant_variantId")
  purchaseOrderItems     PurchaseOrderItem[]     @relation("PurchaseOrderItem_variantId")
  goodsReceiptItems      GoodsReceiptItem[]      @relation("GoodsReceiptItem_variantId")
  stockTransferItems     StockTransferItem[]     @relation("StockTransferItem_variantId")
  cartItems              CartItem[]              @relation("CartItem_variantId")
  orderItems             OrderItem[]             @relation("OrderItem_variantId")
  serialUnits            SerialUnit[]            @relation("SerialUnit_variantId")
  wishlistItems          WishlistItem[]          @relation("WishlistItem_variantId")

  @@unique([productId, optionSignature])
  @@unique([id, productId])
  @@map("product_variants")
}

/// product_options: see docs/database/DATA_DICTIONARY.md.
model ProductOption {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  code      String   @db.VarChar(64)
  name      String   @db.VarChar(100)
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  product             Product              @relation("ProductOption_productId", fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  productOptionValues ProductOptionValue[] @relation("ProductOptionValue_optionId")
  variantOptionValues VariantOptionValue[] @relation("VariantOptionValue_optionId")

  @@unique([productId, code])
  @@map("product_options")
}

/// product_option_values: see docs/database/DATA_DICTIONARY.md.
model ProductOptionValue {
  id        String   @id @default(uuid()) @db.Uuid
  optionId  String   @map("option_id") @db.Uuid
  code      String   @db.VarChar(100)
  label     String   @db.VarChar(150)
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  option              ProductOption        @relation("ProductOptionValue_optionId", fields: [optionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  variantOptionValues VariantOptionValue[] @relation("VariantOptionValue_valueId")

  @@unique([optionId, code])
  @@unique([id, optionId])
  @@map("product_option_values")
}

/// variant_option_values: see docs/database/DATA_DICTIONARY.md.
model VariantOptionValue {
  variantId String   @map("variant_id") @db.Uuid
  optionId  String   @map("option_id") @db.Uuid
  valueId   String   @map("value_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  variant ProductVariant     @relation("VariantOptionValue_variantId", fields: [variantId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  option  ProductOption      @relation("VariantOptionValue_optionId", fields: [optionId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  value   ProductOptionValue @relation("VariantOptionValue_valueId", fields: [valueId, optionId], references: [id, optionId], onDelete: Restrict, onUpdate: Restrict)

  @@id([variantId, optionId])
  @@index([optionId])
  @@index([valueId])
  @@map("variant_option_values")
}

/// attribute_definitions: see docs/database/DATA_DICTIONARY.md.
model AttributeDefinition {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique @db.VarChar(64)
  name         String   @db.VarChar(150)
  dataType     String   @map("data_type") @db.VarChar(32)
  unit         String?  @db.VarChar(32)
  isFilterable Boolean  @map("is_filterable")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  categoryAttributes     CategoryAttribute[]     @relation("CategoryAttribute_attributeId")
  productAttributeValues ProductAttributeValue[] @relation("ProductAttributeValue_attributeId")
  variantAttributeValues VariantAttributeValue[] @relation("VariantAttributeValue_attributeId")

  @@map("attribute_definitions")
}

/// category_attributes: see docs/database/DATA_DICTIONARY.md.
model CategoryAttribute {
  categoryId  String   @map("category_id") @db.Uuid
  attributeId String   @map("attribute_id") @db.Uuid
  isRequired  Boolean  @map("is_required")
  sortOrder   Int      @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  category  Category            @relation("CategoryAttribute_categoryId", fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
